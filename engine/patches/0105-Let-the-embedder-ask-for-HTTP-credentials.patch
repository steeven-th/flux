Subject: [PATCH] Let the embedder ask for HTTP credentials

A 401 or 407 challenge makes Chrome ask for a username and a password in
a web-modal dialog, which LoginHandlerViews shows only when the tab's
dialog manager has a delegate. EngineCore's tabs have none, so the prompt
was cancelled at once and the page showed the server's error. EngineCore
replaces the dialog through a callback and asks its embedder instead.
---
diff --git a/chrome/browser/ui/login/login_handler.h b/chrome/browser/ui/login/login_handler.h
--- a/chrome/browser/ui/login/login_handler.h
+++ b/chrome/browser/ui/login/login_handler.h
@@ -57,6 +57,16 @@ class LoginHandler : public content::LoginDelegate {
       content::WebContents* web_contents,
       content::LoginDelegate::LoginAuthRequiredCallback auth_required_callback);
 
+  // Replaces the handler Create builds. EngineCore (//engine_core) asks its
+  // embedder for the credentials, as its tabs have no host for the
+  // web-modal dialog.
+  using CreateCallback = base::RepeatingCallback<std::unique_ptr<LoginHandler>(
+      const net::AuthChallengeInfo& auth_info,
+      content::WebContents* web_contents,
+      content::LoginDelegate::LoginAuthRequiredCallback
+          auth_required_callback)>;
+  static void SetCreateCallback(CreateCallback callback);
+
   // Call after `Create()` to show the dialog.
   void ShowLoginPrompt(const GURL& request_url);
 
diff --git a/chrome/browser/ui/views/login_handler_views.cc b/chrome/browser/ui/views/login_handler_views.cc
--- a/chrome/browser/ui/views/login_handler_views.cc
+++ b/chrome/browser/ui/views/login_handler_views.cc
@@ -26,6 +26,8 @@ class LoginHandlerViewsDialog;
 
 namespace {
 
+LoginHandler::CreateCallback* g_create_callback = nullptr;
+
 // This class prompts the user for credentials and returns the result to
 // `auth_required_callback`.
 class LoginHandlerViews : public LoginHandler {
@@ -231,6 +233,17 @@ std::unique_ptr<LoginHandler> LoginHandler::Create(
     const net::AuthChallengeInfo& auth_info,
     content::WebContents* web_contents,
     content::LoginDelegate::LoginAuthRequiredCallback auth_required_callback) {
+  // EngineCore's tabs have no dialog manager delegate, so the dialog could
+  // not be built and the challenge was cancelled. Its embedder asks instead.
+  if (g_create_callback) {
+    return g_create_callback->Run(auth_info, web_contents,
+                                  std::move(auth_required_callback));
+  }
   return std::make_unique<LoginHandlerViews>(auth_info, web_contents,
                                              std::move(auth_required_callback));
 }
+
+// static
+void LoginHandler::SetCreateCallback(CreateCallback callback) {
+  g_create_callback = new CreateCallback(std::move(callback));
+}
