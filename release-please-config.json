{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "flux",
      "initial-version": "0.1.0",
      "bump-minor-pre-major": true,
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        "project.yml"
      ]
    }
  },
  "changelog-sections": [
    {
      "type": "feat",
      "section": "New"
    },
    {
      "type": "perf",
      "section": "Faster"
    },
    {
      "type": "fix",
      "section": "Fixed"
    },
    {
      "type": "style",
      "section": "Smaller"
    },
    {
      "type": "refactor",
      "section": "Smaller"
    },
    {
      "type": "build",
      "section": "Build",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "CI",
      "hidden": true
    },
    {
      "type": "docs",
      "section": "Docs",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Chores",
      "hidden": true
    }
  ]
}
