{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ also offers to save passwords, so you may be asked twice." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ propose aussi d'enregistrer les mots de passe, la question pourrait donc vous être posée deux fois."
          }
        }
      }
    },
    "%@ runs a later Chromium than Flux: its history, passwords and sign-ins stay there for now." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ utilise un Chromium plus récent que Flux : son historique, ses mots de passe et ses connexions y restent pour l'instant."
          }
        }
      }
    },
