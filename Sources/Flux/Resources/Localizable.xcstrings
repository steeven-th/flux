    "Profiles keep history, passwords, cookies and extensions apart. Each space uses a profile, and spaces can share one." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les profils séparent l'historique, les mots de passe, les cookies et les extensions. Chaque espace utilise un profil, et plusieurs espaces peuvent en partager un."
          }
        }
      }
    },
