    "The developer bar" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barre de développement"
          }
        }
      }
    },
    "The first rule that matches decides where a link opens. Links no rule matches open as chosen above. Right-click a rule to change its order." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La première règle qui correspond décide où s'ouvre le lien. Les liens sans règle s'ouvrent comme choisi plus haut. Faites un clic droit sur une règle pour changer son ordre."
          }
        }
      }
    },
    "The tab will be removed from your favorites." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'onglet sera retiré de vos favoris."
          }
        }
      }
    },
    "The tab will be removed from your pinned tabs." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'onglet sera retiré de vos onglets épinglés."
          }
        }
      }
    },
    "The translation key was refused" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé de traduction a été refusée"
          }
        }
