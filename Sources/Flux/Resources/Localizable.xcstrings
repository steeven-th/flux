    },
    "The translation quota for this month is reached" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le quota de traduction de ce mois est atteint"
          }
        }
      }
    },
    "Their page is unloaded to free memory, and loads again when you open them, where you left it. Tabs playing sound or a video stay awake." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leur page est déchargée pour libérer la mémoire, puis rechargée à l'endroit où vous l'aviez laissée quand vous les rouvrez. Les onglets qui jouent du son ou une vidéo restent éveillés."
          }
        }
      }
    },
    "This card won't come back. Your extensions are in Flux > Extensions." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette carte ne reviendra pas. Vos extensions sont dans Flux > Extensions."
          }
        }
      }
    },
    "To import %@, allow Flux to read data from other apps in Privacy & Security, under Files & Folders." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour importer %@, autorisez Flux à lire les données des autres apps dans Confidentialité et sécurité, rubrique Fichiers et dossiers."
          }
        }
      }
    },
