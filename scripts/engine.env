# The engine Flux runs on: Chrome's framework built from this Chromium version with the patches and
# the bridge in engine/. scripts/build-engine.sh builds it and scripts/fetch-engine.sh downloads it.
ENGINE_CHROMIUM_VERSION="156.0.8078.109"
# Google publishes no source tarball for Extended Stable releases. The dependencies taken from it
# (TARBALL_DEPS in scripts/build-engine.sh) are pinned to the same commits in this release of the
# same major version.
ENGINE_TARBALL_VERSION="156.0.8078.80"
# Bump to publish a new build of the same Chromium version, after changing engine/ for example.
ENGINE_BUILD="flux2"
ENGINE_SHA256="d903a49e370b7369ee47a4770f2ee196c24501e4c1d8e2f541ac8b07c8d197e9"
