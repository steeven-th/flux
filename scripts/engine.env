# The engine Flux runs on: Chrome's framework built from this Chromium version with the patches and
# the bridge in engine/. scripts/build-engine.sh builds it and scripts/fetch-engine.sh downloads it.
ENGINE_CHROMIUM_VERSION="156.0.8078.80"
# Bump to publish a new build of the same Chromium version, after changing engine/ for example.
ENGINE_BUILD="flux1"
ENGINE_SHA256=""
